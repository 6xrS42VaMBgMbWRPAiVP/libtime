    "contracts",
    "eslint.config.mjs",
    "man",
    "lib",
    "libtime",
    "libtime.webpack.config.cjs",
    "package.json",
    "webpack.config.cjs"
  ],
  "man": [
  ],
  "bin":
    { "etime":
        "ethereum-time",
      "ethereum-time":
        "ethereum-time"
