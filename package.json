      "url":
        "https://github.com/tallero"
  },
  "devDependencies": {
    "crash-js-webpack":
      "^0.0.3",
    "eslint":
      "^10.0.0",
    "globals":
      "^17.3.0",
    "@eslint/js":
      "^10.0.1",
    "webpack":
      "^5.102.1",
    "webpack-cli":
      "^6.0.1"
  },
  "dependencies": {
    "crash-js":
      "^0.1.88",
    "encoding-tools":
      "0.0.4",
    "ethereum-data":
      "0.0.1",
    "evm-wallet":
      "npm:evm-wallet.js@^0.0.3",
    "yargs":
      "18.0.0"
  },
  "type":
    "commonjs",
  "main":
    "libtime",
  "scripts":
    { "build":
        "npm run lint && npm run build-lib && npm build-bin",
    "build-bin":
      "npx webpack --mode 'production' --config 'webpack.config.cjs' --stats-error-details && mv 'ethereum-time.js' 'dist/ethereum-time/ethereum-time.js'",
    "build-lib":
      "npx webpack --mode 'production' --config 'libtime.webpack.config.cjs' --stats-error-details && mv 'libtime.js' 'dist/libtime/libtime.js'",
      "lint":
        "npx eslint .",
      "start":
        "npx safely-serve 'dist/evmfs'",
      "test":
        "echo \"Error: no test specified\" && exit 1" }
}
